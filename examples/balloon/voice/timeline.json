{
 "total": 59.1,
 "lines": [
  {
   "id": "g00_0",
   "who": "narrator",
   "start": 0.0,
   "dur": 4.392,
   "caption": "Hold a plastic bag over a fire, let go, and it flies! Congratulations, you've built a hot-air balloon!"
  },
  {
   "id": "g01_0",
   "who": "ben",
   "start": 4.433,
   "dur": 0.715,
   "caption": "Whoa!"
  },
  {
   "id": "g02_0",
   "who": "narrator",
   "start": 5.2,
   "dur": 2.857,
   "caption": "Hot air spreads out, so a box of it weighs less than a box of cold air."
  },
  {
   "id": "g03_0",
   "who": "narrator",
   "start": 8.1,
   "dur": 2.504,
   "caption": "But once it cools down, it sinks right back... and lands on Ben."
  },
  {
   "id": "g04_0",
   "who": "narrator",
   "start": 10.667,
   "dur": 1.332,
   "caption": "That bag lifts a cookie. But not Ben."
  },
  {
   "id": "g04_1",
   "who": "ben",
   "start": 12.029,
   "dur": 0.776,
   "caption": "Come on!"
  },
  {
   "id": "g05_0",
   "who": "narrator",
   "start": 12.833,
   "dur": 3.392,
   "caption": "One cubic metre of hot air lifts about a sandwich. Ben needs six hundred of them."
  },
  {
   "id": "g06_0",
   "who": "narrator",
   "start": 16.267,
   "dur": 1.402,
   "caption": "So you sew up a bag the size of a house."
  },
  {
   "id": "g07_0",
   "who": "neighbour",
   "start": 17.7,
   "dur": 1.308,
   "caption": "Are those my bedsheets?"
  },
  {
   "id": "g08_0",
   "who": "narrator",
   "start": 19.033,
   "dur": 1.609,
   "caption": "Blow cold air in with a fan to open it up,"
  },
  {
   "id": "g09_0",
   "who": "narrator",
   "start": 20.7,
   "dur": 1.648,
   "caption": "then fire the burner. The hot air stands it up!"
  },
  {
   "id": "g10_0",
   "who": "narrator",
   "start": 22.4,
   "dur": 1.082,
   "caption": "Ben climbs in with a sandwich,"
  },
  {
   "id": "g11_0",
   "who": "narrator",
   "start": 23.533,
   "dur": 1.538,
   "caption": "you untie the rope, and up, up, up he goes!"
  },
  {
   "id": "g12_0",
   "who": "narrator",
   "start": 25.133,
   "dur": 1.529,
   "caption": "The hotter the air inside, the harder it lifts."
  },
  {
   "id": "g13_0",
   "who": "ben",
   "start": 26.7,
   "dur": 1.02,
   "caption": "Lunch time!"
  },
  {
   "id": "g13_1",
   "who": "narrator",
   "start": 27.75,
   "dur": 1.031,
   "caption": "So he turns the burner off."
  },
  {
   "id": "g14_0",
   "who": "narrator",
   "start": 28.8,
   "dur": 3.191,
   "caption": "But the air inside cools down, and below sixty-seven degrees it can't hold him up,"
  },
  {
   "id": "g15_0",
   "who": "narrator",
   "start": 32.033,
   "dur": 1.276,
   "caption": "so it sinks, right towards the neighbour."
  },
  {
   "id": "g16_0",
   "who": "ben",
   "start": 33.333,
   "dur": 1.128,
   "caption": "My sandwich!"
  },
  {
   "id": "g17_0",
   "who": "narrator",
   "start": 34.5,
   "dur": 0.674,
   "caption": "Right on target."
  },
  {
   "id": "g18_0",
   "who": "narrator",
   "start": 35.267,
   "dur": 3.151,
   "caption": "Ben fires the burner, but the air takes a few seconds to heat up, so it keeps on sinking."
  },
  {
   "id": "g19_0",
   "who": "neighbour",
   "start": 38.467,
   "dur": 0.947,
   "caption": "Hey! My roof!"
  },
  {
   "id": "g20_0",
   "who": "narrator",
   "start": 39.467,
   "dur": 1.665,
   "caption": "And balloons don't come with a steering wheel, Ben."
  },
  {
   "id": "g21_0",
   "who": "narrator",
   "start": 41.167,
   "dur": 1.757,
   "caption": "But the wind blows different ways at different heights,"
  },
  {
   "id": "g22_0",
   "who": "narrator",
   "start": 42.967,
   "dur": 1.468,
   "caption": "so you climb into the wind that goes your way."
  },
  {
   "id": "g23_0",
   "who": "narrator",
   "start": 44.467,
   "dur": 1.707,
   "caption": "Next stop: grandma's garden, round the corner."
  },
  {
   "id": "g24_0",
   "who": "narrator",
   "start": 46.2,
   "dur": 2.266,
   "caption": "To come down, pull the vent. Hot air rushes out of the top,"
  },
  {
   "id": "g25_0",
   "who": "narrator",
   "start": 48.5,
   "dur": 1.065,
   "caption": "and down, down, down you go."
  },
  {
   "id": "g26_0",
   "who": "ben",
   "start": 49.6,
   "dur": 1.286,
   "caption": "Too much! Too much!"
  },
  {
   "id": "g27_0",
   "who": "narrator",
   "start": 50.933,
   "dur": 1.907,
   "caption": "The basket hits the lawn, and the wind drags it along,"
  },
  {
   "id": "g28_0",
   "who": "narrator",
   "start": 52.9,
   "dur": 1.648,
   "caption": "until the whole thing flops over the washing line."
  },
  {
   "id": "g29_0",
   "who": "narrator",
   "start": 54.6,
   "dur": 1.77,
   "caption": "Congratulations, you've built a hot-air balloon!"
  },
  {
   "id": "g30_0",
   "who": "grandma",
   "start": 56.4,
   "dur": 1.831,
   "caption": "You could have taken the bus, dear."
  },
  {
   "id": "g31_0",
   "who": "ben",
   "start": 58.267,
   "dur": 0.805,
   "caption": "I know."
  }
 ],
